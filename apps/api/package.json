{
  "name": "@pure-engage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure Engage API (Fastify + PostgreSQL). Runs TypeScript directly on Node 22 type stripping.",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node src/db/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "create-user": "node src/cli/create-user.ts",
    "seed:demo": "node src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pure-engage/purenet-connector": "0.1.0",
    "@pure-engage/shared": "0.1.0",
    "fastify": "5.12.7",
    "kysely": "0.28.18",
    "liquidjs": "10.30.0",
    "nodemailer": "6.10.1",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@pure-engage/sdk": "0.1.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "smtp-server": "3.21.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

# Copy to .env and fill in locally. Never commit real values (CLAUDE.md rule 2).

# API
PORT=4200
PE_DATABASE_URL=postgres://pure_engage@127.0.0.1:5433/pure_engage
PE_TEST_DATABASE_URL=postgres://pure_engage@127.0.0.1:5433/pure_engage_test
PE_SESSION_IDLE_MINUTES=30
PE_SESSION_MAX_HOURS=12
PE_LOGIN_RATE_LIMIT=10
# Optional: create the first admin at startup when there are no users (or use `npm run create-user`).
PE_ADMIN_EMAIL=
PE_ADMIN_PASSWORD=

# Public base URL of the API (tracking, unsubscribe and Twilio callback links)
PE_PUBLIC_URL=http://127.0.0.1:4200
PE_BRAND_NAME=PureHealth

# Delivery. sandbox (default) never contacts a provider. live sends via SMTP/Twilio when configured.
PE_DELIVERY_MODE=sandbox
# Optional live allowlist: emails, @domains or E.164 numbers, comma-separated
PE_DELIVERY_ALLOWLIST=
# Required in production (32+ chars). Keep it stable or old tracking and unsubscribe links stop working.
PE_TRACKING_SECRET=
PE_DEFAULT_TIMEZONE=Asia/Dubai
PE_SMS_QUIET_HOURS=21-8
PE_MARKETING_CAP_PER_WEEK=3
PE_DISPATCH_INTERVAL_MS=2000

# SMTP, e.g. smtps://user:pass@smtp.example.com:465
PE_SMTP_URL=
PE_EMAIL_FROM=Pure Engage <no-reply@example.com>
PE_EMAIL_REPLY_TO=

# Twilio SMS (set TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# PureNet connector (defaults point at the local Prism mocks)
PURENET_BASE_URL=http://127.0.0.1:4010
PURENET_TOKEN_URL=http://127.0.0.1:4011/oauth2/token
PURENET_CLIENT_ID=
PURENET_CLIENT_SECRET=
# Setting this mounts POST /hooks/purenet on the API (min 16 chars).
PURENET_WEBHOOK_SECRET=
